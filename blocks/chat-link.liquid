{%- comment -%}
  Chat link: opens Shopify Inbox from an inline text link instead of the
  floating launcher. Pairs with pdp-column.liquid, which hides the launcher on
  mobile product pages (it collided with the pinned buy bar).

  The link stays hidden until Inbox registers <shopify-chat>, so it never
  renders as a dead control on a store without the app. The click handler is
  delegated from the document because Horizon morphs product details on variant
  change, and scripts inside morphed markup do not re-run.
{%- endcomment -%}

<button
  type="button"
  class="chat-link"
  data-chat-link
  {{ block.shopify_attributes }}
>
  {{- block.settings.label | escape -}}
</button>

<script type="module">
  if (!window.__arttChatLink) {
    window.__arttChatLink = true;

    customElements.whenDefined('shopify-chat').then(() => {
      document.documentElement.classList.add('has-shopify-chat');
    });

    document.addEventListener('click', (event) => {
      const trigger = event.target instanceof Element && event.target.closest('[data-chat-link]');
      if (!trigger) return;

      const chat = document.querySelector('shopify-chat');
      if (!chat) return;

      if (typeof chat.show === 'function') {
        chat.show();
      } else {
        chat.setAttribute('open', '');
      }
    });
  }
</script>

{% stylesheet %}
  .chat-link {
    display: none;
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    cursor: pointer;
  }

  .has-shopify-chat .chat-link {
    display: inline-block;
  }

  .chat-link:hover {
    text-decoration-thickness: 2px;
  }

  .chat-link:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: 3px;
  }

  @media screen and (min-width: 990px) {
    /* Desktop keeps the floating launcher; the link is the route in on
       mobile and tablet, where the launcher is hidden (pdp-column.liquid). */
    .has-shopify-chat .chat-link {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chat link",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Opens Shopify Inbox. Hidden when Inbox is not installed."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Questions? Chat with us"
    }
  ],
  "presets": [
    {
      "name": "Chat link",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
