{%- liquid
  assign block_settings = block.settings
  assign product = closest.product
  
  # Get size guide page from product metafield
  assign size_guide_page = product.metafields.custom.size_guide_page.value
  
  # Only render if size guide page is set
  if size_guide_page == blank
    assign size_guide_page = null
  endif
-%}

{%- if size_guide_page != blank -%}
  <script
    src="{{ 'dialog.js' | asset_url }}"
    type="module"
  ></script>

  <dialog-component
    class="size-guide"
    {{ block.shopify_attributes }}
  >
    <button
      on:click="/showDialog"
      class="button button-unstyled size-guide__button spacing-style {{ block_settings.type_preset }}"
      style="{% render 'spacing-style', settings: block_settings %} --icon-width: {{ block_settings.icon_width }}px;"
      aria-haspopup="dialog"
    >
      {{- block_settings.button_text | default: 'Size Guide' -}}
      {%- if block_settings.icon != 'none' and block_settings.icon != blank -%}
        <svg
          class="size-guide__icon"
          aria-hidden="true"
          focusable="false"
          xmlns="http://www.w3.org/2000/svg"
          width="{{ block_settings.icon_width }}"
          height="{{ block_settings.icon_width }}"
          viewBox="0 0 20 20"
        >
          {%- render 'icon', icon: block_settings.icon -%}
        </svg>
      {%- endif -%}
    </button>

    <dialog
      ref="dialog"
      class="size-guide__content dialog-modal color-custom-popover{% if block_settings.behavior == 'drawer' %} size-guide__content--drawer dialog-drawer{% endif %}"
      scroll-lock
      aria-labelledby="size-guide-heading"
      aria-modal="true"
      role="dialog"
    >
      <div class="size-guide__inner-wrapper">
        <button
          ref="closeButton"
          on:click="/closeDialog"
          class="button button-unstyled close-button size-guide__close"
          aria-label="{{ 'accessibility.close_dialog' | t }}"
        >
          {{- 'icon-close.svg' | inline_asset_content -}}
        </button>
        
        <div class="size-guide__header">
          <h2
            id="size-guide-heading"
            class="size-guide__title{% if block_settings.title_size != blank and block_settings.title_size != 'custom' %} {{ block_settings.title_size }}{% endif %}{% if block_settings.hide_title %} visually-hidden{% endif %}"
            style="{% if block_settings.title_size == 'custom' and block_settings.title_font_size != blank %}font-size: {{ block_settings.title_font_size }};{% endif %}"
          >
            {{ size_guide_page.title | default: 'Size Guide' }}
          </h2>
        </div>
        
        <div class="size-guide__content-wrapper">
          <rte-formatter>
            {{ size_guide_page.content }}
          </rte-formatter>
        </div>
      </div>
    </dialog>
  </dialog-component>
{%- endif -%}

{% javascript %}
  /*
   * Mark the chart row for the size the shopper already picked, so the drawer
   * answers "what does my size measure?" without making them scan for it.
   * Delegated from document: variant changes can morph the product section,
   * and a listener bound to the original nodes would be lost.
   */
  (() => {
    if (window.__sizeGuideRowMarker) return;
    window.__sizeGuideRowMarker = true;

    const normalize = (value) =>
      String(value || '')
        .trim()
        .toUpperCase()
        .replace(/\s+/g, '')
        .replace(/^XXL$/, '2XL')
        .replace(/^XXXL$/, '3XL');

    const selectedSize = (scope) => {
      const inputs = scope.querySelectorAll('input[data-option-name]:checked, select[data-option-name]');
      for (const input of inputs) {
        if (!/size|taille|talla/i.test(input.dataset.optionName || '')) continue;
        return normalize(input.value);
      }
      return '';
    };

    const markRows = (dialog, size) => {
      dialog.querySelectorAll('.size-guide__selected-label').forEach((el) => el.remove());
      dialog.querySelectorAll('tbody tr').forEach((row) => {
        const cell = row.querySelector('td, th');
        const match = Boolean(size) && cell && normalize(cell.textContent) === size;
        row.classList.toggle('size-guide__row--selected', match);
        if (match) {
          const label = document.createElement('span');
          label.className = 'size-guide__selected-label visually-hidden';
          label.textContent = ' (selected)';
          cell.append(label);
        }
      });
    };

    document.addEventListener(
      'click',
      (event) => {
        const button = event.target.closest?.('.size-guide__button');
        if (!button) return;
        const dialog = button.closest('dialog-component')?.querySelector('.size-guide__content');
        if (!dialog) return;
        const scope = button.closest('.shopify-section, product-form-component, main') || document;
        markRows(dialog, selectedSize(scope) || selectedSize(document));
      },
      true
    );
  })();
{% endjavascript %}

{% stylesheet %}
  .size-guide__button {
    text-align: left;
  }

  .size-guide__button svg {
    display: inline-block;
    position: relative;
    top: var(--margin-2xs);
    margin-inline-start: var(--margin-2xs);
    width: var(--icon-width, 16px);
    height: var(--icon-width, 16px);
  }

  .size-guide__content {
    box-shadow: var(--shadow-popover);
    border: var(--style-border-popover);
    border-radius: var(--style-border-radius-popover);
    background-color: var(--color-background);
    padding: var(--padding-4xl) var(--padding-xl) var(--padding-xl);
    max-width: var(--normal-content-width);
    max-height: var(--modal-max-height);
    overflow-y: auto;

    @media screen and (min-width: 750px) {
      padding: var(--padding-5xl);
    }
  }

  .size-guide__content[open] {
    animation: modal-slide-in-top var(--animation-speed) var(--animation-easing) forwards;
  }

  .size-guide__content.dialog-closing {
    animation: modal-slide-out-top var(--animation-speed) var(--animation-easing) forwards;
  }

  .size-guide__content--drawer {
    position: fixed;
    border-radius: 0;
    width: var(--sidebar-width);
    max-width: 95vw;
    height: 100%;
    margin: 0 0 0 auto;
    padding: 0;
    border-left: var(--style-border-drawer);
    box-shadow: var(--shadow-drawer);
  }

  /* Override modal animations for drawer mode - use slide-in animations */
  /* Right-side drawer: slides in from right (100% to 0) and slides out to right (0 to 100%) */
  .size-guide__content--drawer[open] {
    animation: slide-in-left var(--animation-speed) var(--animation-easing) forwards;
  }

  .size-guide__content--drawer.dialog-closing {
    animation: slide-out-left var(--animation-speed) var(--animation-easing) forwards;
  }

  /* Needed to ensure the drawer is full height */
  .size-guide__content--drawer:modal {
    max-height: 100dvh;
    overflow-y: hidden;
  }

  /* Drawer-specific inner wrapper structure */
  .size-guide__content--drawer .size-guide__inner-wrapper {
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow-y: hidden;
  }

  .size-guide__content--drawer .size-guide__header {
    flex-shrink: 0;
    /* Reserve the close button's lane so a two-line title never runs under it. */
    padding: var(--padding-xl) calc(var(--minimum-touch-target) + var(--padding-md)) var(--padding-md) var(--padding-xl);
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10));
  }

  .size-guide__title {
    text-wrap: balance;
  }

  .size-guide__content--drawer .size-guide__content-wrapper {
    flex: 1;
    overflow-y: auto;
    padding: var(--padding-xl);
  }

  /* Modal mode - keep existing structure */
  .size-guide__content:not(.size-guide__content--drawer) .size-guide__inner-wrapper {
    display: block;
  }

  .size-guide__content:not(.size-guide__content--drawer) .size-guide__header {
    padding: 0;
    border-bottom: none;
  }

  .size-guide__content:not(.size-guide__content--drawer) .size-guide__content-wrapper {
    padding: 0;
    overflow-y: visible;
  }

  .size-guide__close {
    position: absolute;
    top: var(--margin-2xs);
    right: var(--margin-2xs);
    opacity: 0.8;
    animation: none;
    z-index: var(--layer-raised);
  }

  .size-guide__close:active {
    transform: scale(0.8);
  }

  .size-guide__title {
    margin-block-start: 0;
    margin-block-end: 0;
  }

  /* Ensure type preset classes apply to title */
  .size-guide__title.h1,
  .size-guide__title.h2,
  .size-guide__title.h3,
  .size-guide__title.h4,
  .size-guide__title.h5,
  .size-guide__title.h6 {
    /* Type preset styles are inherited from base.css .h1, .h2, etc. */
  }

  /* Drawer-specific title styling */
  .size-guide__content--drawer .size-guide__title {
    margin-block-end: 0;
  }

  .size-guide__inner {
    width: 100%;
  }

  /*
   * Size chart content.
   *
   * The chart lives in Shopify pages (admin data, not this repo) and ships its
   * own <style> block: IBM Plex Mono (never loaded, so it falls back to the
   * system mono), a cream/stone palette, 6px-rounded tabs and radio inputs
   * hidden with display:none (unreachable by keyboard). The theme owns
   * presentation here, so these rules restyle it to the ARTT system.
   *
   * `:not(#sg)` adds one ID of specificity on purpose: the page CSS selects its
   * active tab with ID selectors (#sg-tab-unisex:checked ~ ...), and this is the
   * only way to outrank it without !important. Matching is by class and
   * position, so new chart pages with other ID prefixes are covered too.
   */
  .size-guide__content-wrapper:not(#sg) {
    /*
     * Opaque on purpose. The popover foreground is translucent (#000000cf), and
     * Chrome paints collapsed-table borders and row fills per cell; where
     * fractional column edges overlap, translucent paint shows as seams.
     */
    --sg-ink: rgb(var(--color-foreground-rgb));
    --sg-rule: color-mix(in srgb, var(--sg-ink) 12%, var(--color-background));
    --sg-muted: rgb(var(--color-foreground-rgb) / 0.68);
    --sg-meta-font: var(--font-body--family);
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--color-foreground-rgb) / 0.25) transparent;
  }

  .size-guide__content-wrapper:not(#sg) .sg-size-chart {
    font-family: var(--sg-meta-font);
    color: var(--color-foreground);
    max-width: none;
  }

  /* The drawer title already names the guide; the page's tracked kicker repeats it. */
  .size-guide__content-wrapper:not(#sg) .sg-size-chart__heading {
    display: none;
  }

  /* Garment diagram: keep it a reference figure, not the first screenful. */
  .size-guide__content-wrapper:not(#sg) :is(.sg-size-chart, .main-content) > svg {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 13rem;
    margin-block-end: var(--margin-2xl, 2rem);

    @media screen and (min-width: 750px) {
      max-height: 15rem;
    }
  }

  /* Fit tabs: real radios, visually hidden but focusable, driving underline tabs. */
  .size-guide__content-wrapper:not(#sg) .sg-size-chart > input[type='radio'] {
    display: block;
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    opacity: 0;
  }

  .size-guide__content-wrapper:not(#sg) .sg-size-chart__tabs {
    display: flex;
    gap: var(--gap-xl, 1.5rem);
    border: 0;
    border-bottom: 1px solid var(--sg-rule);
    border-radius: 0;
    overflow: visible;
  }

  .size-guide__content-wrapper:not(#sg) .sg-size-chart__tabs .sg-size-chart__tab-label {
    flex: 0 0 auto;
    margin-block-end: -1px;
    padding: 0.75rem 0;
    min-height: var(--minimum-touch-target);
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    background: none;
    color: var(--sg-muted);
    font-family: var(--sg-meta-font);
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    text-align: start;
    transition: color var(--animation-speed) var(--animation-easing),
      border-color var(--animation-speed) var(--animation-easing);
  }

  .size-guide__content-wrapper:not(#sg) .sg-size-chart__tabs .sg-size-chart__tab-label:hover {
    background: none;
    color: var(--color-foreground);
  }

  .size-guide__content-wrapper:not(#sg)
    .sg-size-chart:has(> input:nth-of-type(1):checked)
    .sg-size-chart__tabs
    .sg-size-chart__tab-label:nth-of-type(1),
  .size-guide__content-wrapper:not(#sg)
    .sg-size-chart:has(> input:nth-of-type(2):checked)
    .sg-size-chart__tabs
    .sg-size-chart__tab-label:nth-of-type(2),
  .size-guide__content-wrapper:not(#sg)
    .sg-size-chart:has(> input:nth-of-type(3):checked)
    .sg-size-chart__tabs
    .sg-size-chart__tab-label:nth-of-type(3) {
    background: none;
    color: var(--color-foreground);
    font-weight: 700;
    border-bottom-color: var(--color-foreground);
  }

  .size-guide__content-wrapper:not(#sg)
    .sg-size-chart:has(> input:nth-of-type(1):focus-visible)
    .sg-size-chart__tab-label:nth-of-type(1),
  .size-guide__content-wrapper:not(#sg)
    .sg-size-chart:has(> input:nth-of-type(2):focus-visible)
    .sg-size-chart__tab-label:nth-of-type(2),
  .size-guide__content-wrapper:not(#sg)
    .sg-size-chart:has(> input:nth-of-type(3):focus-visible)
    .sg-size-chart__tab-label:nth-of-type(3) {
    outline: var(--focus-outline-width, 2px) solid currentcolor;
    outline-offset: var(--focus-outline-offset, 3px);
  }

  /*
   * Table rows.
   *
   * Columns are auto-sized and land on fractional pixels, and Chrome paints row
   * fills and collapsed borders once per cell, so any per-cell paint leaves
   * hairline seams at the column edges. Instead, each row's rule and fill is
   * one pseudo-element on its first cell, spanning the full table width (the
   * wrapper is a size container, so 100cqw is the table's width). Nothing is
   * painted per cell, so there is nothing to seam.
   */
  .size-guide__content-wrapper:not(#sg) :is(.rte-table-wrapper, .sg-size-chart__table-wrap) {
    container-type: inline-size;
    background: none;
    border: 0;
    border-radius: 0;
    overflow: visible;
  }

  .size-guide__content-wrapper:not(#sg) :is(table, thead, tbody, tr) {
    border: 0;
    background: none;
  }

  /* Tables: one rule for the chart pages and the older plain RTE tables. */
  .size-guide__content-wrapper:not(#sg) table {
    display: table;
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-family: var(--sg-meta-font);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .size-guide__content-wrapper:not(#sg) :is(th, td) {
    padding: 0.875rem 0 0.875rem var(--padding-md);
    border: 0;
    background: none;
    color: var(--color-foreground);
    font-size: inherit;
    font-weight: 400;
    letter-spacing: 0;
    text-align: end;
    white-space: nowrap;
    transition: color var(--animation-speed) var(--animation-easing);
  }

  /* A small inset on the outer columns lets the selected row read as a bar. */
  .size-guide__content-wrapper:not(#sg) :is(th, td):first-child {
    position: relative;
    padding-inline: 0.75rem var(--padding-md);
    text-align: start;
  }

  .size-guide__content-wrapper:not(#sg) :is(th, td):last-child {
    padding-inline-end: 0.75rem;
  }

  .size-guide__content-wrapper:not(#sg) :is(th, td) :is(p, div) {
    margin: 0;
  }

  /* The row surface: rule along the bottom, fill for hover and selection. */
  .size-guide__content-wrapper:not(#sg) tr > :first-child::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 100cqw;
    z-index: -1;
    border-bottom: 1px solid var(--sg-rule);
    background-color: transparent;
    pointer-events: none;
    transition: background-color var(--animation-speed) var(--animation-easing);
  }

  .size-guide__content-wrapper:not(#sg) tbody tr:last-child > :first-child::before {
    border-bottom-color: transparent;
  }

  /* Column heads: Meta role (Space Mono 12px, 0.13em), on a full Ink rule. */
  .size-guide__content-wrapper:not(#sg) thead :is(th, td) {
    padding-block: 1rem 0.625rem;
    color: var(--sg-muted);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .size-guide__content-wrapper:not(#sg) thead tr > :first-child::before {
    border-bottom-color: var(--sg-ink);
  }

  /* The size is what people scan for, so it is the strongest cell in the row. */
  .size-guide__content-wrapper:not(#sg) tbody tr > :first-child {
    color: var(--color-foreground);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  @media (hover: hover) {
    .size-guide__content-wrapper:not(#sg) tbody tr:hover > :first-child::before {
      background-color: rgb(var(--color-foreground-rgb) / 0.05);
    }
  }

  /* The shopper's current size, inverted like a selected chip, in solid Ink. */
  .size-guide__content-wrapper:not(#sg) tbody tr.size-guide__row--selected > :first-child::before {
    background-color: var(--sg-ink);
    border-bottom-color: var(--sg-ink);
  }

  .size-guide__content-wrapper:not(#sg) tbody tr.size-guide__row--selected > * {
    color: var(--color-background);
  }

  /* Measuring notes and fit advice. */
  .size-guide__content-wrapper:not(#sg) :is(.sg-size-chart__note, .main-content em) {
    display: block;
    margin-block: var(--margin-lg, 1rem) 0;
    color: var(--sg-muted);
    font-family: var(--sg-meta-font);
    font-size: 0.75rem;
    font-style: normal;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }

  .size-guide__content-wrapper:not(#sg) .main-content em {
    margin-block: 0 var(--margin-md, 0.75rem);
  }

  .size-guide__content-wrapper:not(#sg) .main-content > div {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .size-guide__content-wrapper:not(#sg) .main-content table {
    margin-block-end: var(--margin-lg, 1rem);
  }

  .size-guide__content-wrapper:not(#sg) ::selection {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  @media (prefers-reduced-motion: reduce) {
    .size-guide__content-wrapper:not(#sg) :is(th, td, .sg-size-chart__tab-label),
    .size-guide__content-wrapper:not(#sg) tr > :first-child::before {
      transition: none;
    }
  }
{% endstylesheet %}

