#  ┃                                                                      ┃
#  ┃    Agent instructions .... /llms.txt                                 ┃
#  ┃    UCP merchant profile .. /.well-known/ucp                          ┃
#  ┃    Full URL inventory .... /sitemap.xml                              ┃
#  ┃                                                                      ┃
#  ┃  Product, collection, blog and policy pages are open to every        ┃
#  ┃  well-behaved crawler. Only checkout, cart, account and faceted      ┃
#  ┃  duplicate URLs are withheld — they are noise, not secrets.          ┃
#  ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

{%- capture newline %}
{% endcapture -%}

{%- comment -%}
  Shopify's defaults block /policies/, which hides the shipping, refund,
  privacy and terms pages. Those are exactly the pages an answer engine is
  asked to summarise ("what's their return window?"), so they are unblocked
  here. Every other default rule is passed through untouched.

  The `*` ruleset is also captured once and reused verbatim by each named AI
  group below. Naming a crawler explicitly means it stops reading the `*`
  group entirely, so without this the named groups would silently lose any
  protective rule Shopify adds to the defaults in future.
{%- endcomment -%}
{%- capture core_rules -%}
  {%- for group in robots.default_groups -%}
    {%- if group.user_agent.value == '*' -%}
      {%- for rule in group.rules -%}
        {%- unless rule.directive == 'Disallow' and rule.value contains '/policies/' -%}
          {{- rule }}{{ newline -}}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- liquid
  echo newline
  echo newline
  for group in robots.default_groups
    echo group.user_agent
    echo newline
    for rule in group.rules
      unless rule.directive == 'Disallow' and rule.value contains '/policies/'
        echo rule
        echo newline
      endunless
    endfor
    if group.sitemap != blank
      echo group.sitemap
      echo newline
    endif
    echo newline
  endfor
-%}

{%- comment -%}
  Named AI crawlers, in three families:
    training     — GPTBot, ClaudeBot, Google-Extended, Applebot-Extended,
                   meta-externalagent, CCBot, cohere-ai, Bytespider
    retrieval    — OAI-SearchBot, PerplexityBot, Amazonbot, DuckAssistBot,
                   YouBot
    user-fetch   — ChatGPT-User, Claude-User, Perplexity-User,
                   MistralAI-User, meta-externalfetcher

  All are granted the same access as a search engine. This store already
  publishes /llms.txt and a UCP profile inviting agent traffic, so blocking
  the crawlers that feed those same assistants would work against it.

  `Allow: /` is emitted LAST, after the disallows, and that ordering matters.
  RFC 9309 parsers (Google, Bing) pick the longest match and are unaffected,
  but plenty of crawlers use first-match-wins parsers — Python's stdlib
  robotparser among them. Listed first, `Allow: /` would match every path
  immediately and hand those crawlers /checkout, /cart, /admin and /account.
{%- endcomment -%}
{%- assign ai_agents = 'GPTBot,OAI-SearchBot,ChatGPT-User,ClaudeBot,Claude-User,Claude-SearchBot,anthropic-ai,PerplexityBot,Perplexity-User,Google-Extended,Applebot,Applebot-Extended,Amazonbot,meta-externalagent,meta-externalfetcher,DuckAssistBot,CCBot,cohere-ai,cohere-training-data-crawler,MistralAI-User,YouBot,Bytespider' | split: ',' -%}
{%- liquid
  for agent in ai_agents
    echo 'User-agent: '
    echo agent
    echo newline
    echo core_rules
    echo 'Allow: /'
    echo newline
    echo newline
  endfor
  echo 'Sitemap: '
  echo shop.url
  echo '/sitemap.xml'
  echo newline
-%}
