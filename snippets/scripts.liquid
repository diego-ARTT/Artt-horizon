  <script
    src="{{ 'fly-to-cart' | append: _js_ext | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script
    src="{{ 'sticky-add-to-cart' | append: _js_ext | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script type="module">
    import { RecentlyViewed } from '@theme/recently-viewed-products';
    RecentlyViewed.addProduct('{{ product.id }}');
  </script>
{% endif %}

