<script type="module">
  // Defer viewport-based scripts: load when their custom element scrolls near view
  const viewportDeferred = [
    { selector: 'slideshow-component', url: {{ 'slideshow' | append: _js_ext | asset_url | json }} },
    { selector: 'layered-slideshow-component', url: {{ 'layered-slideshow' | append: _js_ext | asset_url | json }} },
    { selector: 'video-background-component', url: {{ 'video-background' | append: _js_ext | asset_url | json }} },
    { selector: 'media-gallery', url: {{ 'media-gallery' | append: _js_ext | asset_url | json }} },
  ];

  viewportDeferred.forEach(({ selector, url }) => {
    const elements = document.querySelectorAll(selector);
    if (!elements.length) return;
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          import(url);
          observer.disconnect();
        }
      },
      { rootMargin: '200px' }
    );
    elements.forEach((el) => observer.observe(el));
  });

  // Defer interaction-based scripts: load on first user gesture
  const interactionDeferred = [
    {{ 'show-more' | append: _js_ext | asset_url | json }},
    {{ 'anchored-popover' | append: _js_ext | asset_url | json }},
    {{ 'floating-panel' | append: _js_ext | asset_url | json }},
    {{ 'rte-formatter' | append: _js_ext | asset_url | json }},
    {{ 'volume-pricing' | append: _js_ext | asset_url | json }},
    {{ 'volume-pricing-info' | append: _js_ext | asset_url | json }},
    {{ 'price-per-item' | append: _js_ext | asset_url | json }},
    {{ 'component-quantity-selector' | append: _js_ext | asset_url | json }},
  ];

  let interactionLoaded = false;
  const loadOnInteraction = () => {
    if (interactionLoaded) return;
    interactionLoaded = true;
    interactionDeferred.forEach((url) => import(url));
  };

  ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach((event) => {
    document.addEventListener(event, loadOnInteraction, { once: true, passive: true });
  });
</script>

