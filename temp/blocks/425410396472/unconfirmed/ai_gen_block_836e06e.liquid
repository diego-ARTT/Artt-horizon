{% doc %}
  @prompt
    shoppable video carousel
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    position: relative;
    display: block;
  }

  .ai-video-carousel__container-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-video-carousel__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
  }

  .ai-video-carousel__slide-{{ ai_gen_id }} {
    min-width: 100%;
    position: relative;
  }

  .ai-video-carousel__video-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    background-color: #000000;
  }

  .ai-video-carousel__hotspots-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .ai-video-carousel__hotspot-{{ ai_gen_id }} {
    position: absolute;
    pointer-events: auto;
  }

  .ai-video-carousel__hotspot-button-{{ ai_gen_id }} {
    width: {{ block.settings.hotspot_size }}px;
    height: {{ block.settings.hotspot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.hotspot_color }};
    border: none;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: {{ block.settings.hotspot_icon_color }};
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s ease;
  }

  .ai-video-carousel__hotspot-button-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-video-carousel__hotspot-button-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.hotspot_size }}px * 0.5);
    height: calc({{ block.settings.hotspot_size }}px * 0.5);
  }

  .ai-video-carousel__popup-{{ ai_gen_id }} {
    position: absolute;
    width: {{ block.settings.popup_width }}px;
    background-color: {{ block.settings.popup_bg_color }};
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    padding: 16px;
    color: {{ block.settings.popup_text_color }};
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    pointer-events: none;
  }

  .ai-video-carousel__popup-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .ai-video-carousel__popup-content-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-video-carousel__popup-close-{{ ai_gen_id }} {
    position: absolute;
    top: -8px;
    right: -8px;
    background: {{ block.settings.popup_bg_color }};
    border: none;
    cursor: pointer;
    padding: 4px;
    color: {{ block.settings.popup_text_color }};
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-video-carousel__popup-close-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-video-carousel__product-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
  }

  .ai-video-carousel__product-image-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
  }

  .ai-video-carousel__product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
  }

  .ai-video-carousel__product-info-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-video-carousel__product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .ai-video-carousel__product-price-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 500;
  }

  .ai-video-carousel__product-link-{{ ai_gen_id }} {
    font-size: 12px;
    text-decoration: underline;
    color: {{ block.settings.popup_text_color }};
    margin-top: 4px;
  }

  .ai-video-carousel__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    align-items: center;
    z-index: 5;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.control_bg_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.control_icon_color }};
    transition: opacity 0.3s ease;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-video-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.control_bg_color }};
    opacity: 0.5;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-video-carousel__play-pause-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.control_bg_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.control_icon_color }};
    z-index: 5;
    transition: opacity 0.3s ease;
  }

  .ai-video-carousel__play-pause-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-video-carousel__play-pause-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-video-carousel__empty-state-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-video-carousel__empty-message-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
  }

  .ai-video-carousel__empty-state-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel__hotspot-button-{{ ai_gen_id }} {
      width: calc({{ block.settings.hotspot_size }}px * 0.8);
      height: calc({{ block.settings.hotspot_size }}px * 0.8);
    }

    .ai-video-carousel__popup-{{ ai_gen_id }} {
      width: calc({{ block.settings.popup_width }}px * 0.8);
    }

    .ai-video-carousel__controls-{{ ai_gen_id }} {
      bottom: 12px;
    }

    .ai-video-carousel__play-pause-{{ ai_gen_id }} {
      top: 12px;
      right: 12px;
    }
  }
{% endstyle %}

<shoppable-video-carousel-{{ ai_gen_id }}
  class="ai-video-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign has_videos = false
    for i in (1..5)
      assign video_key = 'video_' | append: i
      assign video = block.settings[video_key]
      if video != blank
        assign has_videos = true
        break
      endif
    endfor
  %}

  {% if has_videos %}
    <div class="ai-video-carousel__container-{{ ai_gen_id }}">
      <div class="ai-video-carousel__track-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign video_key = 'video_' | append: i
            assign video = block.settings[video_key]
          %}

          {% if video != blank %}
            <div class="ai-video-carousel__slide-{{ ai_gen_id }}" data-slide-index="{{ forloop.index0 }}">
              {{ video | video_tag: autoplay: false, loop: true, controls: false, muted: true, class: 'ai-video-carousel__video-' | append: ai_gen_id }}

              <div class="ai-video-carousel__hotspots-{{ ai_gen_id }}">
                {% for j in (1..3) %}
                  {% liquid
                    assign hotspot_enabled_key = 'video_' | append: i | append: '_hotspot_' | append: j | append: '_enabled'
                    assign hotspot_x_key = 'video_' | append: i | append: '_hotspot_' | append: j | append: '_x'
                    assign hotspot_y_key = 'video_' | append: i | append: '_hotspot_' | append: j | append: '_y'
                    assign product_key = 'video_' | append: i | append: '_product_' | append: j

                    assign hotspot_enabled = block.settings[hotspot_enabled_key]
                    assign hotspot_x = block.settings[hotspot_x_key]
                    assign hotspot_y = block.settings[hotspot_y_key]
                    assign product = block.settings[product_key]
                  %}

                  {% if hotspot_enabled %}
                    <div
                      class="ai-video-carousel__hotspot-{{ ai_gen_id }}"
                      style="left: {{ hotspot_x }}%; top: {{ hotspot_y }}%;"
                      data-hotspot-id="{{ i }}-{{ j }}"
                    >
                      <button
                        class="ai-video-carousel__hotspot-button-{{ ai_gen_id }}"
                        aria-label="View product"
                        aria-expanded="false"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="12" y1="8" x2="12" y2="16"></line>
                          <line x1="8" y1="12" x2="16" y2="12"></line>
                        </svg>
                      </button>

                      <div class="ai-video-carousel__popup-{{ ai_gen_id }}">
                        <div class="ai-video-carousel__popup-content-{{ ai_gen_id }}">
                          {% if product != blank %}
                            <div class="ai-video-carousel__product-{{ ai_gen_id }}">
                              <div class="ai-video-carousel__product-image-{{ ai_gen_id }}">
                                {% if product.featured_image %}
                                  <img
                                    src="{{ product.featured_image | image_url: width: 160 }}"
                                    alt="{{ product.featured_image.alt | escape }}"
                                    width="160"
                                    height="160"
                                    loading="lazy"
                                  >
                                {% endif %}
                              </div>
                              <div class="ai-video-carousel__product-info-{{ ai_gen_id }}">
                                <h3 class="ai-video-carousel__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                                <div class="ai-video-carousel__product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
                                <a href="{{ product.url }}" class="ai-video-carousel__product-link-{{ ai_gen_id }}">View product</a>
                              </div>
                            </div>
                          {% endif %}
                          <button class="ai-video-carousel__popup-close-{{ ai_gen_id }}" aria-label="Close">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <line x1="18" y1="6" x2="6" y2="18"></line>
                              <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                          </button>
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <button class="ai-video-carousel__play-pause-{{ ai_gen_id }}" aria-label="Play/Pause video">
        <svg class="ai-video-carousel__play-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <svg class="ai-video-carousel__pause-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
          <rect x="6" y="4" width="4" height="16"></rect>
          <rect x="14" y="4" width="4" height="16"></rect>
        </svg>
      </button>

      <div class="ai-video-carousel__controls-{{ ai_gen_id }}">
        <button class="ai-video-carousel__nav-button-{{ ai_gen_id }} ai-video-carousel__prev-{{ ai_gen_id }}" aria-label="Previous video">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="ai-video-carousel__dots-{{ ai_gen_id }}"></div>

        <button class="ai-video-carousel__nav-button-{{ ai_gen_id }} ai-video-carousel__next-{{ ai_gen_id }}" aria-label="Next video">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  {% else %}
    <div class="ai-video-carousel__empty-state-{{ ai_gen_id }}">
      {{ 'image' | placeholder_svg_tag }}
      <div class="ai-video-carousel__empty-message-{{ ai_gen_id }}">
        Next, add videos to create your shoppable carousel
      </div>
    </div>
  {% endif %}
</shoppable-video-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class ShoppableVideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.isPlaying = false;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-video-carousel__track-{{ ai_gen_id }}');
        this.slides = this.querySelectorAll('.ai-video-carousel__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-video-carousel__prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-video-carousel__next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-video-carousel__dots-{{ ai_gen_id }}');
        this.playPauseButton = this.querySelector('.ai-video-carousel__play-pause-{{ ai_gen_id }}');
        this.playIcon = this.querySelector('.ai-video-carousel__play-icon-{{ ai_gen_id }}');
        this.pauseIcon = this.querySelector('.ai-video-carousel__pause-icon-{{ ai_gen_id }}');

        if (!this.track || this.slides.length === 0) return;

        this.setupDots();
        this.setupEventListeners();
        this.updateCarousel();
      }

      setupDots() {
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-video-carousel__dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to video ${index + 1}`);
          if (index === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });
        this.dots = this.querySelectorAll('.ai-video-carousel__dot-{{ ai_gen_id }}');
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.prev());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.next());
        }
        if (this.playPauseButton) {
          this.playPauseButton.addEventListener('click', () => this.togglePlayPause());
        }

        this.querySelectorAll('.ai-video-carousel__hotspot-button-{{ ai_gen_id }}').forEach(button => {
          button.addEventListener('click', (e) => {
            e.stopPropagation();
            const hotspot = button.closest('.ai-video-carousel__hotspot-{{ ai_gen_id }}');
            const popup = hotspot.querySelector('.ai-video-carousel__popup-{{ ai_gen_id }}');
            
            this.querySelectorAll('.ai-video-carousel__popup-{{ ai_gen_id }}').forEach(p => {
              if (p !== popup) {
                p.classList.remove('active');
              }
            });

            const isActive = popup.classList.contains('active');
            popup.classList.toggle('active');
            button.setAttribute('aria-expanded', !isActive);

            if (!isActive) {
              this.positionPopup(popup, button);
            }
          });
        });

        this.querySelectorAll('.ai-video-carousel__popup-close-{{ ai_gen_id }}').forEach(closeButton => {
          closeButton.addEventListener('click', (e) => {
            e.stopPropagation();
            const popup = closeButton.closest('.ai-video-carousel__popup-{{ ai_gen_id }}');
            popup.classList.remove('active');
            const button = popup.previousElementSibling;
            button.setAttribute('aria-expanded', 'false');
          });
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('.ai-video-carousel__hotspot-{{ ai_gen_id }}')) {
            this.querySelectorAll('.ai-video-carousel__popup-{{ ai_gen_id }}').forEach(popup => {
              popup.classList.remove('active');
            });
          }
        });

        this.slides.forEach(slide => {
          const video = slide.querySelector('video');
          if (video) {
            video.addEventListener('ended', () => {
              if (this.currentIndex < this.slides.length - 1) {
                this.next();
              } else {
                this.isPlaying = false;
                this.updatePlayPauseIcon();
              }
            });
          }
        });
      }

      positionPopup(popup, button) {
        const buttonRect = button.getBoundingClientRect();
        const containerRect = this.getBoundingClientRect();
        const popupWidth = popup.offsetWidth;
        const popupHeight = popup.offsetHeight;

        const spaceAbove = buttonRect.top - containerRect.top;
        const spaceBelow = containerRect.bottom - buttonRect.bottom;
        const spaceLeft = buttonRect.left - containerRect.left;
        const spaceRight = containerRect.right - buttonRect.right;

        popup.style.left = '';
        popup.style.right = '';
        popup.style.top = '';
        popup.style.bottom = '';
        popup.style.transform = '';

        if (spaceBelow >= popupHeight + 10) {
          popup.style.top = '100%';
          popup.style.marginTop = '10px';
        } else if (spaceAbove >= popupHeight + 10) {
          popup.style.bottom = '100%';
          popup.style.marginBottom = '10px';
        } else {
          popup.style.top = '100%';
          popup.style.marginTop = '10px';
        }

        if (spaceRight >= popupWidth / 2) {
          popup.style.left = '50%';
          popup.style.transform = 'translateX(-50%)';
        } else if (spaceLeft >= popupWidth) {
          popup.style.right = '0';
        } else {
          popup.style.left = '0';
        }
      }

      togglePlayPause() {
        const currentVideo = this.slides[this.currentIndex].querySelector('video');
        if (!currentVideo) return;

        if (this.isPlaying) {
          currentVideo.pause();
          this.isPlaying = false;
        } else {
          currentVideo.play();
          this.isPlaying = true;
        }
        this.updatePlayPauseIcon();
      }

      updatePlayPauseIcon() {
        if (this.isPlaying) {
          this.playIcon.style.display = 'none';
          this.pauseIcon.style.display = 'block';
        } else {
          this.playIcon.style.display = 'block';
          this.pauseIcon.style.display = 'none';
        }
      }

      prev() {
        if (this.currentIndex > 0) {
          this.goToSlide(this.currentIndex - 1);
        }
      }

      next() {
        if (this.currentIndex < this.slides.length - 1) {
          this.goToSlide(this.currentIndex + 1);
        }
      }

      goToSlide(index) {
        this.querySelectorAll('.ai-video-carousel__popup-{{ ai_gen_id }}').forEach(popup => {
          popup.classList.remove('active');
        });

        const currentVideo = this.slides[this.currentIndex].querySelector('video');
        if (currentVideo) {
          currentVideo.pause();
          currentVideo.currentTime = 0;
        }

        this.currentIndex = index;
        this.updateCarousel();

        const newVideo = this.slides[this.currentIndex].querySelector('video');
        if (newVideo && this.isPlaying) {
          newVideo.play();
        }
      }

      updateCarousel() {
        this.track.style.transform = `translateX(-${this.currentIndex * 100}%)`;

        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex === this.slides.length - 1;
        }
      }
    }

    customElements.define('shoppable-video-carousel-{{ ai_gen_id }}', ShoppableVideoCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Shoppable video carousel",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Hotspots"
    },
    {
      "type": "range",
      "id": "hotspot_size",
      "label": "Hotspot size",
      "min": 24,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hotspot_icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Product popup"
    },
    {
      "type": "range",
      "id": "popup_width",
      "label": "Width",
      "min": 200,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 280
    },
    {
      "type": "color",
      "id": "popup_bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "popup_text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Controls"
    },
    {
      "type": "color",
      "id": "control_bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "control_icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Video 1"
