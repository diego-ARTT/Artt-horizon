{%- liquid
  assign s = section.settings
-%}
<div class="icons-lp" data-icons-lp>
  {%- assign questions = section.blocks | where: "type", "question" -%}
  {% if s.hero_style == 'question_video' and questions.size > 0 %}
    <section class="icons-hero" data-icons-hero aria-label="{{ s.hero_topleft | escape }}">
      <div class="icons-hero__bg"
        {%- if s.hero_video == blank and s.hero_poster != blank %} style="background-image:url('{{ s.hero_poster | image_url: width: 1600 }}')"{% endif -%}>
        {% if s.hero_video != blank %}
          <video class="icons-hero__video" autoplay muted loop playsinline preload="metadata"
            {% if s.hero_poster != blank %}poster="{{ s.hero_poster | image_url: width: 1600 }}"{% elsif s.hero_video.preview_image %}poster="{{ s.hero_video.preview_image | image_url: width: 1600 }}"{% endif %}>
            {% for source in s.hero_video.sources %}
              {% if source.format == 'mp4' or source.format == 'webm' %}<source src="{{ source.url }}" type="video/{{ source.format }}">{% endif %}
            {% endfor %}
          </video>
        {% endif %}
      </div>
      <div class="icons-hero__scrim"></div>
      <div class="icons-hero__stage">
        <div class="icons-hero__top">
          <span class="icons-hero__kicker">{{ s.hero_topleft | escape }}</span>
          <span class="icons-hero__kicker">{{ s.hero_topright | escape }}</span>
        </div>
        <div class="icons-hero__center">
          <h1 class="icons-hero__q" data-hero-q>{{ questions[0].settings.text | escape }}</h1>
          <p class="icons-lp__visually-hidden" data-hero-live aria-live="polite"></p>
        </div>
        <div class="icons-hero__bottom">
          {% if s.hero_cta != blank %}<a class="icons-hero__cta" href="#icons-subscribe">{{ s.hero_cta | escape }}</a>{% endif %}
          <div class="icons-hero__dots" data-hero-dots aria-hidden="true"></div>
          {% if s.hero_scarcity != blank %}<span class="icons-hero__scarcity">{{ s.hero_scarcity | escape }}</span>{% endif %}
        </div>
      </div>
      <script type="application/json" data-hero-questions>[{% for b in questions %}{{ b.settings.text | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
      <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    </section>
  {% else %}
    <header class="icons-lp__hero">
      {% if s.hero_kicker != blank %}<p class="icons-lp__kicker">{{ s.hero_kicker | escape }}</p>{% endif %}
      {% if s.hero_heading != blank %}<h1 class="icons-lp__headline">{{ s.hero_heading | escape }}</h1>{% endif %}
      {% if s.hero_subline != blank %}<p class="icons-lp__subline">{{ s.hero_subline | escape }}</p>{% endif %}
      {% if s.hero_scarcity != blank %}<p class="icons-lp__scarcity">{{ s.hero_scarcity | escape }}</p>{% endif %}
      {% if s.hero_cta != blank %}<a class="icons-lp__cta" href="#icons-subscribe">{{ s.hero_cta | escape }}</a>{% endif %}
    </header>
  {% endif %}

  {%- assign looks = section.blocks | where: "type", "look" -%}
  {% if looks.size > 0 %}
    <section class="icons-lp__grid" aria-label="ICONS lookbook">
      {% for block in looks %}
        {% if block.settings.image != blank %}
          <figure class="icons-lp__look" {{ block.shopify_attributes }}>
            <img
              src="{{ block.settings.image | asset_url }}"
              alt="{{ block.settings.alt | default: 'ARTTITUDE ICONS look' | escape }}"
              width="1530"
              height="2048"
              loading="lazy"
              decoding="async">
          </figure>
        {% endif %}
      {% endfor %}
    </section>
  {% endif %}
  <section class="icons-lp__subscribe" id="icons-subscribe">
    {% if s.subscribe_kicker != blank %}<p class="icons-lp__kicker">{{ s.subscribe_kicker | escape }}</p>{% endif %}
    {% if s.subscribe_line != blank %}<p class="icons-lp__sub-line">{{ s.subscribe_line | escape }}</p>{% endif %}
    <form
      class="icons-lp__form"
      data-icons-subscribe
      data-klaviyo-company="{{ s.klaviyo_public_key | escape }}"
      data-klaviyo-list="{{ s.klaviyo_list_id | escape }}"
      data-msg-invalid="{{ s.msg_invalid | escape }}"
      data-msg-loading="{{ s.msg_loading | escape }}"
      data-msg-success="{{ s.msg_success | escape }}"
      data-msg-error="{{ s.msg_error | escape }}"
      novalidate>
      <label class="icons-lp__visually-hidden" for="icons-email">{{ s.subscribe_placeholder | escape }}</label>
      <input
        id="icons-email"
        class="icons-lp__input"
        type="email"
        name="email"
        autocomplete="email"
        autocapitalize="off"
        placeholder="{{ s.subscribe_placeholder | escape }}"
        required>
      <input
        class="icons-lp__visually-hidden"
        type="text"
        name="company_website"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true">
      <button class="icons-lp__submit" type="submit">{{ s.subscribe_button | escape }}</button>
      <p class="icons-lp__status" data-status role="status" aria-live="polite"></p>
    </form>
  </section>
</div>

{% stylesheet %}
  @font-face {
    font-family: "Bodoni Moda";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("bodoni-moda-latin-600-normal.woff2") format("woff2");
  }
  @font-face {
    font-family: "Bodoni Moda";
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url("bodoni-moda-latin-700-normal.woff2") format("woff2");
  }
  .icons-lp {
    --lp-bg: #0A0A0A;
    --lp-ink: #111111;
    --lp-fg: #E4E1DA;
    --lp-muted: #9A948B;
    --lp-hairline: rgba(228, 225, 218, 0.14);
    background: var(--lp-bg);
    color: var(--lp-fg);
    font-family: "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .icons-lp * { box-sizing: border-box; }

  .icons-lp__kicker {
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.7rem;
    color: var(--lp-muted);
    margin: 0;
  }

  .icons-lp__hero {
    min-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.5rem;
    padding: 6rem clamp(1.25rem, 6vw, 4rem);
  }
  .icons-lp__headline {
    text-transform: uppercase;
    letter-spacing: -0.025em;
    line-height: 0.95;
    font-weight: 600;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    max-width: 14ch;
    margin: 0;
  }
  .icons-lp__subline {
    color: var(--lp-fg);
    font-size: clamp(1rem, 2vw, 1.25rem);
    margin: 0;
    opacity: 0.85;
  }
  .icons-lp__scarcity {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.72rem;
    color: var(--lp-muted);
    margin: 0.5rem 0 0;
  }
  .icons-lp__cta {
    margin-top: 1.5rem;
    display: inline-block;
    background: var(--lp-fg);
    color: var(--lp-bg);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.72rem;
    padding: 1rem 2.25rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .icons-lp__cta { transition: opacity 0.25s ease; }
  }
  .icons-lp__cta:hover { opacity: 0.82; }

  html:has(.icons-lp) { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html:has(.icons-lp) { scroll-behavior: auto; }
  }

  .icons-lp__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    width: 100%;
  }
  @media screen and (min-width: 750px) {
    .icons-lp__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media screen and (min-width: 1200px) {
    .icons-lp__grid { grid-template-columns: repeat(4, 1fr); }
  }
  .icons-lp__look {
    margin: 0;
    overflow: hidden;
    background: var(--lp-ink);
    aspect-ratio: 3 / 4;
  }
  .icons-lp__look img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .icons-lp__look img { transition: transform 0.6s ease; }
    .icons-lp__look:hover img { transform: scale(1.03); }
  }

  .icons-lp__visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }
  .icons-lp__subscribe {
    text-align: center;
    padding: clamp(4rem, 12vw, 9rem) clamp(1.25rem, 6vw, 4rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--lp-hairline);
  }
  .icons-lp__sub-line {
    max-width: 40ch;
    color: var(--lp-fg);
    opacity: 0.85;
    margin: 0 0 1rem;
  }
  .icons-lp__form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 30rem;
  }
  .icons-lp__input {
    flex: 1 1 16rem;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--lp-hairline);
    color: var(--lp-fg);
    font-size: 1rem;
    padding: 0.85rem 0.25rem;
  }
  .icons-lp__input::placeholder { color: var(--lp-muted); }
  .icons-lp__input:focus-visible {
    outline: none;
    border-bottom-color: var(--lp-fg);
  }
  .icons-lp__submit {
    flex: 0 0 auto;
    background: var(--lp-fg);
    color: var(--lp-bg);
    border: 0;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.72rem;
    padding: 0.95rem 2rem;
  }
  .icons-lp__submit[disabled] { opacity: 0.6; cursor: default; }
  .icons-lp__status {
    flex-basis: 100%;
    min-height: 1.2em;
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--lp-muted);
  }
  .icons-lp__status[data-state="error"] { color: #E4B4B0; }
  .icons-lp__status[data-state="success"] { color: var(--lp-fg); }

  .icons-hero {
    position: relative; height: 100vh; height: 100dvh; min-height: 640px; overflow: hidden;
    background: var(--lp-bg);
    color: #F4F1EB;
    font-family: "Helvetica Neue", Arial, sans-serif;
  }
  .icons-hero__bg { position:absolute; inset:-8%; z-index:0; background-size:cover; background-position:60% 24%; }
  .icons-hero__video {
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
    filter: blur(24px) brightness(0.46) saturate(0.92);
    transform: scale(1.08);
  }
  @media (prefers-reduced-motion: no-preference) {
    .icons-hero__video { animation: icons-hero-drift 34s ease-in-out infinite alternate; }
  }
  @keyframes icons-hero-drift { from{transform:scale(1.08)} to{transform:scale(1.16) translate3d(-1.5%,-1%,0)} }
  .icons-hero__scrim {
    position:absolute; inset:0; z-index:1;
    background:
      linear-gradient(90deg, rgba(10,10,10,0.8) 0%, rgba(10,10,10,0.5) 40%, rgba(10,10,10,0.1) 70%, rgba(10,10,10,0.3) 100%),
      linear-gradient(180deg, rgba(10,10,10,0.5) 0%, rgba(10,10,10,0) 24%, rgba(10,10,10,0) 58%, rgba(10,10,10,0.92) 100%);
  }
  .icons-hero__stage {
    position:relative; z-index:2; height:100%;
    display:grid; grid-template-rows:auto 1fr auto;
    padding-inline: clamp(1.5rem, 5vw, 4.5rem);
  }
  .icons-hero__top { display:flex; justify-content:space-between; align-items:center; padding-top:1.5rem; }
  .icons-hero__kicker { text-transform:uppercase; letter-spacing:0.34em; font-size:0.66rem; color:rgba(244,241,235,0.6); }
  .icons-hero__center { display:flex; align-items:center; }
  .icons-hero__q {
    width:min(15ch, 66vw);
    font-family:"Bodoni Moda", Georgia, serif; font-weight:700;
    font-size: clamp(2.5rem, 6vw, 5.4rem);
    line-height:1.05; letter-spacing:-0.01em; text-align:left; text-wrap:balance;
    color:#F4F1EB; margin:0;
    text-shadow: 0 2px 34px rgba(0,0,0,0.5);
  }
  .icons-hero__q .w { display:inline-block; overflow:hidden; vertical-align:top; padding:0.06em 0; }
  .icons-hero__q .i { display:inline-block; will-change:transform, filter, opacity; }
  .icons-hero__bottom { display:flex; align-items:center; gap:1.75rem; padding-bottom:clamp(2rem,5vh,3.4rem); flex-wrap:wrap; }
  .icons-hero__cta {
    display:inline-block; text-decoration:none; text-transform:uppercase;
    letter-spacing:0.28em; font-size:0.66rem; color:var(--lp-bg); background:#F4F1EB; padding:0.95rem 2.4rem;
  }
  @media (prefers-reduced-motion: no-preference) { .icons-hero__cta { transition: opacity .25s ease; } }
  .icons-hero__cta:hover { opacity:0.85; }
  .icons-hero__dots { display:flex; gap:0.5rem; }
  .icons-hero__dot { width:6px; height:6px; border-radius:50%; background:rgba(244,241,235,0.26); border:0; padding:0; cursor:pointer; transition:.4s; }
  .icons-hero__dot[aria-current="true"] { background:#F4F1EB; transform:scale(1.15); }
  .icons-hero__scarcity { text-transform:uppercase; letter-spacing:0.24em; font-size:0.62rem; color:rgba(244,241,235,0.6); margin-left:auto; }
  @media (max-width: 700px) {
    .icons-hero__q { width:min(12ch, 90vw); }
    .icons-hero__scarcity { display:none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .icons-hero__q .w { overflow: visible; }
    .icons-hero__q .i { filter: none !important; transform: none !important; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var forms = document.querySelectorAll('[data-icons-subscribe]');
    forms.forEach(function (form) {
      if (form.dataset.bound === 'true') return;
      form.dataset.bound = 'true';

      var input = form.querySelector('input[type="email"]');
      var honey = form.querySelector('input[name="company_website"]');
      var button = form.querySelector('button[type="submit"]');
      var status = form.querySelector('[data-status]');
      var company = form.dataset.klaviyoCompany;
      var listId = form.dataset.klaviyoList;

      function setStatus(msg, state) {
        if (!status) return;
        status.textContent = msg || '';
        status.dataset.state = state || '';
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (honey && honey.value) return;

        var email = (input.value || '').trim();
        var valid = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email);
        if (!valid) { setStatus(form.dataset.msgInvalid, 'error'); input.focus(); return; }
        if (!company || !listId) { setStatus(form.dataset.msgError, 'error'); return; }

        button.disabled = true;
        setStatus(form.dataset.msgLoading, 'loading');

        fetch('https://a.klaviyo.com/client/subscriptions?company_id=' + encodeURIComponent(company), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/vnd.api+json',
            'revision': '2026-04-15'
          },
          body: JSON.stringify({
            data: {
              type: 'subscription',
              attributes: {
                custom_source: 'ICONS Landing Page',
                profile: {
                  data: {
                    type: 'profile',
                    attributes: {
                      email: email,
                      subscriptions: { email: { marketing: { consent: 'SUBSCRIBED' } } }
                    }
                  }
                }
              },
              relationships: { list: { data: { type: 'list', id: listId } } }
            }
          })
        }).then(function (res) {
          if (res.status === 202 || res.ok) {
            form.reset();
            setStatus(form.dataset.msgSuccess, 'success');
            button.textContent = form.dataset.msgSuccess;
          } else {
            button.disabled = false;
            setStatus(form.dataset.msgError, 'error');
          }
        }).catch(function () {
          button.disabled = false;
          setStatus(form.dataset.msgError, 'error');
        });
      });
    });

    var ctas = document.querySelectorAll('.icons-lp__cta[href="#icons-subscribe"]');
    ctas.forEach(function (cta) {
      cta.addEventListener('click', function () {
        var el = document.getElementById('icons-email');
        if (el) { setTimeout(function () { el.focus({ preventScroll: true }); }, 500); }
      });
    });
  })();

  (function () {
    var root = document.querySelector('[data-icons-hero]');
    if (!root || root.dataset.heroBound === 'true') return;
    root.dataset.heroBound = 'true';

    var qEl = root.querySelector('[data-hero-q]');
    var dotsEl = root.querySelector('[data-hero-dots]');
    var dataEl = root.querySelector('[data-hero-questions]');
    var liveEl = root.querySelector('[data-hero-live]');
    if (!qEl || !dataEl) return;

    var QUESTIONS;
    try { QUESTIONS = JSON.parse(dataEl.textContent) || []; } catch (e) { QUESTIONS = []; }
    if (QUESTIONS.length === 0) { QUESTIONS = [qEl.textContent]; }

    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var idx = 0, busy = false, timer = null, started = false;

    // dots (buttons, keyboard-operable). The container is aria-hidden while empty
    // (no-JS); now that it holds focusable buttons, expose it to assistive tech.
    dotsEl.removeAttribute('aria-hidden');
    var dots = [];
    QUESTIONS.forEach(function (_, i) {
      var b = document.createElement('button');
      b.className = 'icons-hero__dot';
      b.type = 'button';
      b.setAttribute('aria-label', 'Question ' + (i + 1));
      if (i === 0) b.setAttribute('aria-current', 'true');
      b.addEventListener('click', function () { if (liveEl) { liveEl.textContent = QUESTIONS[i]; } go(i); });
      dotsEl.appendChild(b); dots.push(b);
    });
    function setDots(n) { dots.forEach(function (d, i) { if (i === n) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); }); }

    function build(text) {
      qEl.innerHTML = '';
      var words = text.split(' ');
      words.forEach(function (word, i) {
        var w = document.createElement('span'); w.className = 'w';
        var inner = document.createElement('span'); inner.className = 'i';
        inner.textContent = word;
        w.appendChild(inner); qEl.appendChild(w);
        // inter-word space as a text node OUTSIDE the overflow:hidden .w, so it
        // renders and offers a wrap opportunity (a trailing space inside .w is clipped)
        if (i < words.length - 1) { qEl.appendChild(document.createTextNode(' ')); }
      });
      return qEl.querySelectorAll('.i');
    }

    function enter(text) {
      var inners = build(text);
      if (reduce || !window.gsap) { qEl.style.opacity = 0; requestAnimationFrame(function () { qEl.style.transition = 'opacity .4s ease'; qEl.style.opacity = 1; }); return; }
      window.gsap.set(inners, { yPercent: 118, opacity: 0, filter: 'blur(7px)' });
      window.gsap.to(inners, { yPercent: 0, opacity: 1, filter: 'blur(0px)', duration: 0.95, ease: 'expo.out', stagger: 0.055 });
    }

    function go(n) {
      if (busy || n === idx) return; busy = true;
      if (reduce || !window.gsap) {
        qEl.style.transition = 'opacity .3s ease'; qEl.style.opacity = 0;
        setTimeout(function () { idx = n; setDots(n); enter(QUESTIONS[n]); busy = false; }, 300);
        return;
      }
      var inners = qEl.querySelectorAll('.i');
      window.gsap.to(inners, { yPercent: -72, opacity: 0, filter: 'blur(7px)', duration: 0.44, ease: 'power2.in', stagger: 0.022,
        onComplete: function () { idx = n; setDots(n); enter(QUESTIONS[n]); busy = false; } });
    }
    function next() { go((idx + 1) % QUESTIONS.length); }

    function startAuto() {
      if (reduce || started) return; started = true;
      // qEl already shows QUESTIONS[0] server-side; wrap it for animation parity
      enter(QUESTIONS[0]);
      function pause() { clearInterval(timer); }
      function resume() { clearInterval(timer); timer = setInterval(next, 4600); }
      resume();
      // pause the auto-rotation on hover AND on keyboard focus (WCAG 2.2.2)
      root.addEventListener('pointerenter', pause);
      root.addEventListener('pointerleave', resume);
      root.addEventListener('focusin', pause);
      root.addEventListener('focusout', resume);
    }

    // lazy-init when in view; GSAP may still be loading (deferred) — poll briefly
    function boot() {
      var tries = 0;
      (function waitGsap() {
        if (window.gsap || reduce || tries > 40) { startAuto(); return; }
        tries++; setTimeout(waitGsap, 50);
      })();
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { io.disconnect(); boot(); } });
      }, { rootMargin: '0px' });
      io.observe(root);
    } else { boot(); }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "ICONS Lookbook",
  "tag": "section",
  "class": "icons-lp-section",
  "settings": [
    { "type": "header", "content": "Klaviyo" },
    { "type": "text", "id": "klaviyo_public_key", "label": "Klaviyo public API key (company id)", "info": "Public/site key only — never a private key." },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo list ID (ICONS – Launch Notify)" },
    { "type": "header", "content": "Hero style" },
    { "type": "select", "id": "hero_style", "label": "Hero style", "default": "question_video",
      "options": [
        { "value": "question_video", "label": "Question video" },
        { "value": "type_only", "label": "Type only" }
      ] },
    { "type": "video", "id": "hero_video", "label": "Hero video", "info": "Blurred, looping backdrop for the Question video hero." },
    { "type": "image_picker", "id": "hero_poster", "label": "Hero poster / fallback", "info": "Shown before the video loads and where video isn't set." },
    { "type": "text", "id": "hero_topleft", "label": "Top-left label", "default": "ICONS" },
    { "type": "text", "id": "hero_topright", "label": "Top-right label", "default": "A New Collection" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_kicker", "label": "Kicker", "default": "A New Collection" },
    { "type": "text", "id": "hero_heading", "label": "Headline", "default": "You already know these faces." },
    { "type": "text", "id": "hero_subline", "label": "Subline", "default": "You just can't place them all yet." },
    { "type": "text", "id": "hero_scarcity", "label": "Scarcity line", "default": "Twelve icons · Five hundred of each · Then never again" },
    { "type": "text", "id": "hero_cta", "label": "CTA label", "default": "Get Notified" },
    { "type": "header", "content": "Subscribe" },
    { "type": "text", "id": "subscribe_kicker", "label": "Kicker", "default": "Be First" },
